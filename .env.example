# 이 파일은 예시이며 실제 시크릿은 절대 commit하지 않는다.
# Claude 인증은 다음 우선순위로 적용된다:
#   1) CLAUDE_CODE_OAUTH_TOKEN — Claude Code 구독 토큰 (Bearer 헤더, 개인/실험용)
#   2) ANTHROPIC_API_KEY       — Anthropic 콘솔 API 키 (x-api-key 헤더, 운영 권장)
# 둘 다 설정되면 OAuth 토큰이 우선한다.

APP_ENV=local
LOG_LEVEL=INFO              # 헌법 VI — 기본 INFO 고정, 프로덕션 DEBUG 금지
LOG_DIR=./logs              # 헌법 VI — backend/app.log + frontend/access.log 적재 루트
                            # scripts/dev-up.sh 가 저장소 루트의 절대경로로 export 한다.
REQUEST_ID_HEADER=x-request-id

DATABASE_URL=sqlite+aiosqlite:///./var/db/app.db
STORAGE_ROOT=./var/storage  # 다운로드 영상/자막 적재 루트. scripts/dev-up.sh 가
                            # 저장소 루트의 절대경로 (예: <repo>/var/storage) 로 export.

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
TRANSLATION_MODEL=claude-opus-4-7

RATE_LIMIT_PER_MIN=10
ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be

JOB_CONCURRENCY=2

# yt-dlp anti-bot 우회 — YouTube 가 "Sign in to confirm you're not a bot" 게이트를 띄울 때
# 로컬 브라우저 쿠키로 인증된 세션으로 호출한다. 비어 있으면 옵션 미적용(기본 동작).
# 허용: safari | chrome | firefox | edge | brave | chromium | opera | vivaldi
# 헌법 IV — 로컬 호스트 전제. 브라우저에 YouTube 로 로그인되어 있어야 효과 발생.
YT_DLP_COOKIES_BROWSER=firefox
